{
  "name": "DropIt – Gesture File Sharing",
  "short_name": "DropIt",
  "description": "Send any file or folder with a grab gesture, receive it with a drop gesture.",
  "id": "/",
  "start_url": "/home",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
