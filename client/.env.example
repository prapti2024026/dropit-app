# Set the API URL to the machine running the backend server.
# Replace 192.168.1.10 with the server laptop's LAN IP address.
VITE_API_URL=http://192.168.1.10:5000

# If this is the laptop that uploads files, use id1.
VITE_USER_ID=id1

# If this is the laptop that receives files, use id2.
VITE_RECEIVER_ID=id2

# To swap roles on the two laptops, swap the IDs and reload the app.
# Example for the other laptop:
# VITE_USER_ID=id2
# VITE_RECEIVER_ID=id1
