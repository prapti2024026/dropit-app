# Address of the DropIt server (the "server" folder).
# Local testing:      http://localhost:5000
# Phone on same Wi-Fi: http://<your laptop's LAN IP>:5000   (camera needs HTTPS on phones, see UPDATE_NOTES.md)
# Deployed:           https://your-server.example.com
VITE_API_URL=http://localhost:5000

# Optional: pre-fill the "Send to" box
# VITE_RECEIVER_USERNAME=

# Must match the server's MAX_FILE_MB (default 50)
# VITE_MAX_FILE_MB=50

# Optional: use your own gesture model trained with MediaPipe Model Maker
# (labels "grab"/"fist", "drop"/"open", "none"). Default is MediaPipe's built-in model.
# VITE_GESTURE_MODEL_URL=/models/dropit_gestures.task
